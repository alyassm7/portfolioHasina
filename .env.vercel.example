###############################################
# Variables Vercel — Portfolio Hasina
# Copier chaque clé dans :
# Vercel → Project → Settings → Environment Variables
# (Production + Preview si besoin)
###############################################

# --- Application ---
APP_NAME="Portfolio Hasina"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Générer avec : php artisan key:generate --show
# Exemple : base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

APP_URL=https://votre-projet.vercel.app
APP_TIMEZONE=Indian/Antananarivo

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# --- Logs (obligatoire sur Vercel) ---
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Base de données MySQL distante (obligatoire) ---
# Ex. Railway, PlanetScale, Aiven, Hostinger, etc.
DB_CONNECTION=mysql
DB_HOST=votre-host.mysql.db
DB_PORT=3306
DB_DATABASE=portfolio_hasina
DB_USERNAME=votre_user
DB_PASSWORD=votre_password

# --- Session / Cache (adapté serverless) ---
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (optionnel : réponses admin) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-app
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hasinaralison7@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Divers ---
ADMIN_EMAIL=admin@hasina.dev
BCRYPT_ROUNDS=12

###############################################
# Chemins cache Vercel (/tmp) — déjà dans vercel.json
# Pas besoin de les recréer sauf override :
#
# VIEW_COMPILED_PATH=/tmp/views
# APP_CONFIG_CACHE=/tmp/config.php
# APP_ROUTES_CACHE=/tmp/routes.php
# APP_SERVICES_CACHE=/tmp/services.php
# APP_PACKAGES_CACHE=/tmp/packages.php
# APP_EVENTS_CACHE=/tmp/events.php
###############################################

# Après le premier déploiement avec la DB :
# 1. En local, pointez temporairement .env vers la DB Vercel
# 2. php artisan migrate --force
# 3. php artisan db:seed --force
# 4. Remettez votre .env local
